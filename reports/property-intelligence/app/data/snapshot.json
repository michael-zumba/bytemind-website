  "definitions": {
    "standard_listings": "listings that pass the standard-property classifier; non-standard types (relocatable, leasehold-only, retirement etc.) are excluded",
    "homes_avm": "standard listings whose primary valuation range is the Homes.co.nz AVM shown on the Trade Me listing (standard listings only)",
    "homes_avm_pct": "homes_avm as a percentage of standard listings (standard listings only)",
    "sold_comps": "standard listings whose primary range comes from comparable sales, i.e. comp_cv_normalised + comp_absolute (standard listings only)",
    "comp_cv_normalised": "standard listings valued by the CV-normalised comparable-sales model (sale price / CV ratios; value_source 'sold_comps') (standard listings only)",
    "comp_absolute": "standard listings valued by the raw nearby-sales fallback (value_source 'sold_comps_absolute') (standard listings only)",
    "active_guide": "standard listings valued from the active suburb guide only (standard listings only)",
    "hedonic_fallback": "standard listings valued by the calibrated hedonic fallback model (standard listings only)",
    "with_range_pct": "share of standard listings with a complete low/mid/high value range (standard listings only)",
    "all_listings.homes_avm": "all collected listings whose primary range is a Homes.co.nz AVM, including non-standard ones (all collected listings; reference only)",
    "all_listings.sold_comps": "all collected listings with a comparable-sales range, including non-standard ones (all collected listings; reference only)",
    "all_listings.active_guide": "all collected listings valued from the active suburb guide, including non-standard ones (all collected listings; reference only)",
    "mape_with_cv": "mean absolute percentage error of the hedonic AVM under 5-fold cross-validation, as a fraction",
    "median_ape_with_cv": "median absolute percentage error of the hedonic AVM under 5-fold cross-validation, as a fraction",
    "mape_no_cv": "mean absolute percentage error of the no-CV hedonic variant, as a fraction",
    "interval_level": "nominal level of the reported prediction interval (0.8 = 80%)",
    "median_value_mid": "median of the primary value-range midpoints across standard listings",
    "median_cv": "median council capital value across standard listings",
    "median_cv_ratio": "median of per-listing value midpoint ÷ council CV, across standard listings where both exist (this is a median of ratios, not median value ÷ median CV)",
    "mean_cv_ratio": "arithmetic mean of per-listing value midpoint ÷ council CV, across standard listings where both exist (context only)",
    "median_days_on_market": "median days on market across standard listings",
    "below_avm_count": "standard listings asking below their primary value midpoint, counted only where the stored deal gap is reliable (high/medium confidence, non-leasehold)",
    "below_avm_pct": "below_avm_count as a percentage of standard listings",
    "suburbs.median_value_mid": "median primary value midpoint across the suburb's standard listings",
